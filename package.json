{
  "name": "bing-create",
  "version": "0.1.0",
  "description": "Generate images using Bing Image Creator",
  "keywords": [
    "bing",
    "ai",
    "text-to-image",
    "image-generation",
    "chatgpt"
  ],
  "license": "MIT",
  "author": "David Duran <dadch1404@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/totallynotdavid/bing-create.git"
  },
  "bugs": {
    "url": "https://github.com/totallynotdavid/bing-create/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "readme.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bun install --frozen-lockfile",
    "lint:ts": "bunx biome check .",
    "lint:docs": "bunx oxfmt --check '**/*.md' '**/*.yml'",
    "lint": "bun run lint:ts && bun run lint:docs",
    "fix:ts": "bunx biome check --write .",
    "fix:docs": "bunx oxfmt '**/*.md' '**/*.yml'",
    "fix": "bun run fix:ts && bun run fix:docs",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test --path-ignore-patterns tests/integration.test.ts",
    "test:integration": "bun test tests/integration.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "build": "bunx bunup",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bunx bunup"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "bunup": "^0.16.32",
    "oxfmt": "^0.75.0",
    "typescript": "^7.0.2"
  }
}
